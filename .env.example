# Base de datos (Doc 4 / Doc 8 Bloque 4). Siempre con el rol de aplicación
# `gestor_app` (infra/postgres/init/01-rol-aplicacion.sql), NUNCA con un
# superusuario: Postgres exime a los superusuarios de RLS y el aislamiento
# por negocio quedaría desactivado. El backend lo verifica al arrancar.
DATABASE_URL="postgresql://gestor_app:gestor_app@localhost:5432/gestor_encargos?schema=public"

# Ambiente: development | staging | production (Doc 3 Bloque 4)
NODE_ENV=development

# Auth (Doc 3 ADR-009, Doc 5 Bloque 1, Doc 8 Bloque 2)
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="90d"
GOOGLE_CLIENT_ID="reemplazar-por-el-client-id-de-google-sign-in"

# Firebase Admin SDK (auth + FCM, Doc 3 ADR-006/009, Doc 8 Bloque 3)
FIREBASE_PROJECT_ID="reemplazar"
FIREBASE_CLIENT_EMAIL="reemplazar"
FIREBASE_PRIVATE_KEY="reemplazar"

# Cloudflare R2 (Doc 3 ADR-007, Doc 8 Bloque 3)
R2_ACCOUNT_ID="reemplazar"
R2_ACCESS_KEY_ID="reemplazar"
R2_SECRET_ACCESS_KEY="reemplazar"
R2_BUCKET_NAME="gestor-encargos-fotos"

# Puerto del servidor
PORT=3000
